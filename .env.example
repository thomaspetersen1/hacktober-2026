# Single env file for the whole project.
# Copy to .env (git-ignored) at the repo root and fill in. Never commit real values.

# ---------- Frontend (Vite) ----------
# Only VITE_-prefixed vars are exposed to the browser. Never put secrets in VITE_ vars.
# Leave empty in dev to use the Vite proxy; set to the deployed API origin in production.
VITE_API_BASE=

# ---------- Backend (FastAPI) ----------
# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Snowflake connection
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Prop prices: auto (Snowflake, else backend/data/props.csv) | local | snowflake
CATALOG_SOURCE=auto
# Table in SNOWFLAKE_DATABASE.SNOWFLAKE_SCHEMA with columns name, category, theme, price (see sql/props.sql)
PROPS_TABLE=PROPS

# Open-weight model served by Snowflake Cortex (writes the theme, story and rooms)
CORTEX_MODEL=llama3.3-70b
# Room ideas: auto (Cortex if Snowflake is set up, else a fixed house) | fixed | ai
IDEAS_SOURCE=auto

# Local fallback via Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
